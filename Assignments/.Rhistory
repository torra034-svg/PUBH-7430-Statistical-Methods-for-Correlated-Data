model_2b |>
tidy(exponentiate = TRUE, conf.int = TRUE) |>
kable(digits = 3)
model_2b_exponentiated_odds_ratio <- exp(model_2b$coefficients[2])
model_2b_odds_percent <- 1 - model_2b_exponentiated_odds_ratio
model_2b_odds_percent
odds_percent |>
round(digits = 2)
model_2b_rr_percent |>
round(digits = 2)
