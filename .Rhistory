#| label: stats
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
chick_model <- lm(weight ~ Time + Diet, data = chicks)
summary(chicks)
#| label: stats
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
chick_model <- lm(weight ~ Time + Diet, data = chicks)
summary(chick_model)
#| label: stats
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
chick_model <- lm(weight ~ Time + Diet, data = chicks)
summary(chick_model)
library(kableExtra)
kable(
chick_model,
digits = 3,
caption = "Linear Regression Model: Chick Weight by Time and Diet"
)
#| label: stats
