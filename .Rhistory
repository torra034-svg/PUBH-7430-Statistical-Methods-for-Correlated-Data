#| label: library
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
library(tidyverse) #clean data
#| label: import
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
chicks <- read_csv("chicks.csv")
obs <- nrow(chicks)
col <- ncol(chicks)
View(chicks)
obs <- nrow(chicks)
col <- ncol(chicks)
chicks_grouped <- chicks |>
group_by(Chick, Diet) |>
summarize(
repeat_measurement = n())
View(chicks_grouped)
View(chicks)
#| label: boxplot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(chicks, aes(x = Time, y = weight)) +
geom_boxplot()
#| label: boxplot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(chicks, aes(x = Time, y = weight)) +
geom_boxplot() +
labs(
x = "Time (Day)",
y = "Weight"
)
#| label: boxplot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(chicks, aes(y = weight)) +
geom_boxplot() +
labs(
y = "Weight",
title = "Chick Weight Distribution"
)
boxplot.stats(chicks$weight)
#| label: graph
#| message: FALSE
#| warning: FALSE
