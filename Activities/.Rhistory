library(tidyverse)
library(tidymodels)
library(kableExtra)
library(stats)
library(broom)
gum <- read_csv("gumR2026.csv") |>
filter(trtgroup != "Placebo")
# Chunk 2: q1
#| label: q1
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Continuous GLM
model_1 <- glm(
mut3mos ~ trtgroup,
family = gaussian(link = "identity"),
data = gum
)
summary(model_1)
kable(tidy(model_1, conf.int = TRUE),
digits = 3)
# Chunk 3: q2
#| label: q2
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Interaction Model
model_2 <- glm(
mut3mos ~ trtgroup * mutpre,
family = gaussian(link = "identity"),
data = gum
)
summary(model_2)
kable(tidy(model_2, conf.int = TRUE),
digits = 3)
